{
  "name": "personal-site-2025",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio for Jesper Falkenby",
  "license": "MIT",
  "author": "Jesper Falkenby",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prebuild": "bun run scripts/copy-pdf-worker.ts",
    "dev": "bun run prebuild && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "dependencies": {
    "@heroui/button": "2.2.32",
    "@heroui/link": "2.2.26",
    "@heroui/navbar": "2.2.30",
    "@heroui/system": "2.4.28",
    "@heroui/theme": "2.4.26",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pdfjs-dist": "5.4.296",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "10.5.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.2",
    "@react-types/shared": "3.33.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
